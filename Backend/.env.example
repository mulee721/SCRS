# Database Configuration
MONGODB_URI=mongodb://localhost:27017/scrs
MONGODB_USERNAME=scrs_user
MONGODB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_chars_required_here
JWT_EXPIRATION=900
JWT_REFRESH_SECRET=your_super_secure_refresh_token_secret_min_32_chars_required
JWT_REFRESH_EXPIRATION=604800

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourdomain.com

# Security
BCRYPT_ROUNDS=12        # 12 ≈ 250 ms login; raise to 13-14 for higher security

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
